<UserControl
    x:Class="Namsiz.WPF.Window.Ribbon.Controls.ExcelFilterHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">
    <UserControl.Resources>
        <!--  底部文字链接按钮（清除筛选）  -->
        <Style x:Key="FilterTextButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1F6AEB" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  中性按钮（取消）  -->
        <Style x:Key="FilterNeutralButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="14 1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="White"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F4FA" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9BB8E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4EAF3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮（确定）  -->
        <Style x:Key="FilterPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="18 1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="#2F7BF6"
                            BorderBrush="#2F7BF6"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F6AEB" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1F6AEB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A5BD0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#A9C6F5" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A9C6F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Margin="0 0 1 0"
            VerticalAlignment="Center"
            Text="{Binding ColumnName, ElementName=Root}" />

        <Button
            x:Name="FilterButton"
            Grid.Column="1"
            Click="FilterButton_Click"
            Cursor="Hand"
            ToolTip="筛选">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="3 1"
                        Background="Transparent"
                        CornerRadius="2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3DFFA500" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#66FFA500" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Path
                x:Name="FilterIcon"
                Width="11"
                Height="10"
                Margin="1 2"
                Data="M0,0 L15,0 L9,8 L9,14 L6,12.4 L6,8 Z"
                Fill="#666"
                Stretch="Uniform" />
        </Button>

        <Popup
            x:Name="FilterPopup"
            AllowsTransparency="True"
            Closed="FilterPopup_Closed"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=FilterButton}"
            PopupAnimation="Fade"
            StaysOpen="False">
            <Border
                MinWidth="210"
                Padding="0"
                Background="White"
                BorderBrush="#B8B8B8"
                BorderThickness="1"
                CornerRadius="3"
                RenderOptions.BitmapScalingMode="LowQuality"
                RenderOptions.CachingHint="Cache">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="6"
                        Opacity="0.25"
                        ShadowDepth="2" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  搜索框  -->
                    <Grid Grid.Row="0" Margin="6 6 6 4">
                        <TextBox
                            x:Name="SearchBox"
                            Height="24"
                            Padding="4 1"
                            VerticalContentAlignment="Center"
                            TextChanged="SearchBox_TextChanged" />
                        <TextBlock
                            x:Name="SearchHint"
                            Margin="8 0 0 0"
                            VerticalAlignment="Center"
                            Foreground="Gray"
                            IsHitTestVisible="False"
                            Text="搜索..."
                            TextOptions.TextFormattingMode="Display">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!--  全选  -->
                    <CheckBox
                        x:Name="SelectAllBox"
                        Grid.Row="1"
                        Margin="8 0 8 2"
                        VerticalAlignment="Center"
                        Click="SelectAllBox_Click"
                        Content="全选" />

                    <!--  值列表  -->
                    <ScrollViewer
                        Grid.Row="2"
                        MaxHeight="230"
                        Padding="0 2 0 2"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ItemsPanel" />
                    </ScrollViewer>

                    <!--  底部操作：清除筛选 / 取消 / 确定  -->
                    <Border
                        Grid.Row="3"
                        Padding="8 5"
                        Background="#F5F5F5"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0 1 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Padding="2 0 10 0"
                                HorizontalAlignment="Left"
                                Click="ClearButton_Click"
                                Content="清除筛选"
                                Style="{StaticResource FilterTextButtonStyle}" />
                            <Button
                                Grid.Column="1"
                                Margin="0 0 6 0"
                                Click="CancelButton_Click"
                                Content="取消"
                                Style="{StaticResource FilterNeutralButtonStyle}" />
                            <Button
                                Grid.Column="2"
                                Click="OkButton_Click"
                                Content="确定"
                                Style="{StaticResource FilterPrimaryButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
