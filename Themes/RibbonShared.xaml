<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Namsiz.WPF.Window.Ribbon.Controls"
    xmlns:conv="clr-namespace:Namsiz.WPF.Window.Ribbon.Converters">

    <!--
        功能区共享资源（配色 + 命令按钮外观）。
        由 Ribbon.xaml（控件默认样式）与 RibbonItems.xaml（功能区内部的隐式样式）共同合并，
        因此这里只放"带键"的资源，不能放 Ribbon 自身的隐式样式（会与模板资源形成循环引用）。
    -->

    <conv:NullToVisibilityConverter x:Key="Namsiz.Ribbon.Converters.NullToVisibility" />

    <!--#region 配色（可在应用资源中覆盖同名键）-->
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.ContentBackground" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.Border" Color="#E1E3E6" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.TabForeground" Color="#444444" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.TabSelectedForeground" Color="#1F6AEB" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.TabHoverBackground" Color="#E5E7EA" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.GroupHeaderForeground" Color="#7C7C7C" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.ButtonForeground" Color="#333333" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.ButtonHoverBackground" Color="#E8F1FC" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.ButtonHoverBorder" Color="#C3DCF7" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.ButtonPressedBackground" Color="#D5E6FA" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.TopmostForeground" Color="#666666" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.TopmostActiveForeground" Color="#1F6AEB" />
    <SolidColorBrush x:Key="Namsiz.Ribbon.Brushes.TopmostCheckedBackground" Color="#CECECE" />
    <!--#endregion-->

    <!--#region 命令按钮：内置 Button 的 Ribbon 外观（图标在上、文字在下）-->
    <ControlTemplate x:Key="Namsiz.Ribbon.Templates.CommandButton" TargetType="Button">
        <!--  ClipToBounds：标题过长时只裁在按钮内，不会盖到相邻按钮  -->
        <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="3"
            SnapsToDevicePixels="True">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <!--  没有设置图标时整个图标位折叠，按钮自动变成纯文字按钮  -->
                <Border
                    x:Name="IconBox"
                    Width="24"
                    Height="24"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    Visibility="{Binding Path=(c:RibbonProperties.Icon), RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource Namsiz.Ribbon.Converters.NullToVisibility}}">
                    <Image
                        x:Name="Icon"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Path=(c:RibbonProperties.Icon), RelativeSource={RelativeSource AncestorType=Button}}"
                        Stretch="Uniform" />
                </Border>
                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextElement.FontSize="12"
                    TextElement.Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Namsiz.Ribbon.Brushes.ButtonHoverBackground}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Namsiz.Ribbon.Brushes.ButtonHoverBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Namsiz.Ribbon.Brushes.ButtonPressedBackground}" />
            </Trigger>
            <!--
                刻意不做 IsKeyboardFocused 高亮：鼠标点完按钮后键盘焦点会一直留在按钮上，
                看起来就像"点过之后留了个框"。键盘可达性由 Tab 键 + 按下态（IsPressed）保证。
            -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Namsiz.Ribbon.Styles.CommandButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Namsiz.Ribbon.Brushes.ButtonForeground}" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Margin" Value="2,4" />
        <Setter Property="MinWidth" Value="58" />
        <Setter Property="MaxWidth" Value="130" />
        <Setter Property="MinHeight" Value="84" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Namsiz.Ribbon.Templates.CommandButton}" />
    </Style>

    <!--  下拉面板里的菜单项：图标在左、文字在右的紧凑行  -->
    <Style x:Key="Namsiz.Ribbon.Styles.MenuButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Namsiz.Ribbon.Brushes.ButtonForeground}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                x:Name="Icon"
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding Path=(c:RibbonProperties.Icon), RelativeSource={RelativeSource AncestorType=Button}}"
                                Stretch="Uniform"
                                Visibility="{Binding Path=(c:RibbonProperties.Icon), RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource Namsiz.Ribbon.Converters.NullToVisibility}}" />
                            <ContentPresenter
                                VerticalAlignment="Center"
                                TextElement.FontSize="12"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Namsiz.Ribbon.Brushes.ButtonHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

</ResourceDictionary>
