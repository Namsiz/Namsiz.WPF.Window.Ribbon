<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Namsiz.WPF.Window.Ribbon.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Namsiz.WPF.Window.Ribbon;component/Themes/RibbonShared.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        功能区控件默认样式（Ribbon / RibbonTabItem / RibbonGroup / RibbonDropDownButton）。
        设计约定：
          · 按钮一律是 WPF 内置 Button，图标用附加属性 RibbonProperties.Icon 挂载，外观全由样式呈现；
          · 只有页签、分组、下拉按钮这类"结构复杂"的控件才自定义；
          · 默认样式按类型自动生效，使用方不需要合并本字典。
    -->

    <!--#region 分组：内容在上、标题在下，右侧一条分隔线-->
    <Style TargetType="{x:Type c:RibbonGroup}">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <!--
        竖排优先：先在一个列里从上往下排，排满 ContentHeight 再开下一列（见 RibbonItemsPanel）。
        这样「输入框 + 标签」这类窄元素会自动两两成列，而大按钮本来就占满一列，视觉不变。
        -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <c:RibbonItemsPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:RibbonGroup}">
                    <Grid Margin="3,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" LastChildFill="True">
                            <ContentPresenter
                                Margin="0,0,0,3"
                                DockPanel.Dock="Bottom"
                                HorizontalAlignment="Center"
                                ContentSource="Header"
                                TextElement.FontSize="11"
                                TextElement.Foreground="{StaticResource Namsiz.Ribbon.Brushes.GroupHeaderForeground}" />
                            <!--  固定高度：所有分组（含空分组）同高，换页签时命令区高度不跳动  -->
                            <ItemsPresenter Height="{TemplateBinding ContentHeight}" />
                        </DockPanel>
                        <Rectangle
                            Grid.Column="1"
                            Width="1"
                            Margin="4,7"
                            Fill="{StaticResource Namsiz.Ribbon.Brushes.Border}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region 页签：扁平文字页签，选中项与命令区同底色-->
    <Style TargetType="{x:Type c:RibbonTabItem}">
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="Foreground" Value="{StaticResource Namsiz.Ribbon.Brushes.TabForeground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:RibbonTabItem}">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="4,4,0,0"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            x:Name="Header"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header"
                            TextElement.FontSize="12.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Namsiz.Ribbon.Brushes.TabHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Namsiz.Ribbon.Brushes.ContentBackground}" />
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{StaticResource Namsiz.Ribbon.Brushes.TabSelectedForeground}" />
                            <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="#AAAAAA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region 最小化按钮（页签栏右端的小箭头）-->
    <Style x:Key="Namsiz.Ribbon.Styles.MinimizeButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTip" Value="最小化功能区（也可双击页签）" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                        <Path
                            x:Name="Chevron"
                            Width="10"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M0,0 L4.5,4.5 L9,0"
                            RenderTransformOrigin="0.5,0.5"
                            Stroke="#6E6E6E"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Namsiz.Ribbon.Brushes.TabHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region 置顶按钮-->
    <Style x:Key="Namsiz.Ribbon.Styles.TopmostButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="31" />
        <Setter Property="Height" Value="31" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTip" Value="置顶窗口" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Bd"
                        Background="Transparent"
                        CornerRadius="3">
                        <Path
                            x:Name="Icon"
                            Margin="8"
                            Data="M128 128l768 0 0 89.6-768 0 0-89.6ZM732.288 496 555.7888 309.8624c-10.9504-11.2064-26.4128-18.4896-43.7888-18.4896s-32.832 7.2832-43.6032 18.6048L291.5264 495.8656c-9.2288 10.0224-15.1104 22.9696-15.1104 37.3248 0 30.816 26.3808 55.8016 58.8992 55.8016 0.4544 0 0.896-0.0576 1.344-0.0704l0 0.352L416 589.2736 416 896l192 0L608 589.2736l77.1904 0 0-0.448c1.1648 0.064 2.3104 0.1792 3.5008 0.1792 32.5248 0 58.8992-24.992 58.8992-55.8144C747.5904 518.8352 741.7024 505.8944 732.288 496z"
                            Fill="{StaticResource Namsiz.Ribbon.Brushes.TopmostForeground}"
                            Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Icon" Property="Fill" Value="{StaticResource Namsiz.Ribbon.Brushes.TopmostActiveForeground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Namsiz.Ribbon.Brushes.TopmostCheckedBackground}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{StaticResource Namsiz.Ribbon.Brushes.TopmostActiveForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region 功能区本体-->
    <Style TargetType="{x:Type c:Ribbon}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Ribbon}">
                    <ControlTemplate.Resources>
                        <!--  控件外观只在功能区内部生效，不会波及窗口其它区域  -->
                        <ResourceDictionary Source="pack://application:,,,/Namsiz.WPF.Window.Ribbon;component/Themes/RibbonItems.xaml" />
                    </ControlTemplate.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            页签栏：图标 | 页签 | 标题（在剩余空间内居中） | 置顶 + 窗口按钮预留位
                            功能区整块贴到窗口左右边缘（左边界 = 0），窗口图标画在功能区自己的左上角，
                            内容再留 8~12px 边距，所以最左侧不会出现"图标占一列、功能区从中间开始"的割裂感。
                        -->
                        <Grid
                            x:Name="PART_Headers"
                            Height="{TemplateBinding HeaderHeight}"
                            Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                x:Name="PART_WindowIcon"
                                Grid.Column="0"
                                Width="26"
                                Margin="2,0,6,0"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{TemplateBinding WindowIcon}"
                                Stretch="Uniform"
                                Visibility="{Binding WindowIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Namsiz.Ribbon.Converters.NullToVisibility}}" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Stretch"
                                Orientation="Horizontal">
                                <ScrollViewer
                                    x:Name="PART_TabScroll"
                                    MaxWidth="620"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalAlignment="Stretch"
                                    VerticalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                                <ToggleButton
                                    x:Name="PART_MinimizeButton"
                                    IsChecked="{Binding IsMinimized, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource Namsiz.Ribbon.Styles.MinimizeButton}" />
                            </StackPanel>

                            <TextBlock
                                x:Name="PART_Title"
                                Grid.Column="2"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="#3A3A3A"
                                IsHitTestVisible="False"
                                Text="{TemplateBinding Title}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />

                            <StackPanel
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ToggleButton
                                    x:Name="PART_TopmostButton"
                                    IsChecked="{Binding IsTopmost, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource Namsiz.Ribbon.Styles.TopmostButton}" />
                                <Rectangle
                                    x:Name="PART_TopmostSeparator"
                                    Width="1"
                                    Height="14"
                                    Margin="3,0"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource Namsiz.Ribbon.Brushes.Border}" />
                                <!--  为窗口按钮（最小化/最大化/关闭）预留位置，标题居中时不会压到它们  -->
                                <Border Width="{TemplateBinding WindowButtonsWidth}" />
                            </StackPanel>
                        </Grid>

                        <!--  命令区：整条贴到窗口左右边缘，内容左右各留 10px 呼吸位  -->
                        <Border
                            x:Name="PART_ContentPanel"
                            Grid.Row="1"
                            Padding="8,0"
                            Background="{StaticResource Namsiz.Ribbon.Brushes.ContentBackground}"
                            BorderBrush="{StaticResource Namsiz.Ribbon.Brushes.Border}"
                            BorderThickness="0,0,0,1">
                            <ContentControl x:Name="PART_ContentHost" Focusable="False">
                                <ItemsControl
                                    x:Name="PART_Groups"
                                    Focusable="False"
                                    ItemsSource="{Binding SelectedItem.Groups, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ContentControl>
                        </Border>

                        <!--
                            最小化状态下的命令面板。
                            StaysOpen 必须为 True：一旦交给 Popup 自己捕获鼠标（False），
                            鼠标移到别的页签时功能区收不到 MouseMove，"悬停即切换"就失效了。
                            点外部的收起由 Ribbon 代码统一处理（见 OnHostWindowMouseDown / OnGroupsPreviewMouseUp）。
                        -->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsPopupOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=PART_Headers}"
                            PopupAnimation="Fade"
                            StaysOpen="True">
                            <Border
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Margin="8"
                                Background="{StaticResource Namsiz.Ribbon.Brushes.ContentBackground}"
                                BorderBrush="{StaticResource Namsiz.Ribbon.Brushes.Border}"
                                BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="12"
                                        Color="Black"
                                        Opacity="0.2"
                                        ShadowDepth="2" />
                                </Border.Effect>
                                <ContentControl x:Name="PART_PopupHost" Focusable="False" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMinimized" Value="True">
                            <Setter TargetName="PART_ContentPanel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding ShowTopmostButton, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                            <Setter TargetName="PART_TopmostButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TopmostSeparator" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region 下拉按钮：外观同命令按钮，末尾多一个展开箭头，点击弹出菜单面板-->
    <Style TargetType="{x:Type c:RibbonDropDownButton}" BasedOn="{StaticResource Namsiz.Ribbon.Styles.CommandButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:RibbonDropDownButton}">
                    <Grid>
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Image
                                    x:Name="Icon"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding Path=(c:RibbonProperties.Icon), RelativeSource={RelativeSource AncestorType=Button}}"
                                    Stretch="Uniform"
                                    Visibility="{Binding Path=(c:RibbonProperties.Icon), RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource Namsiz.Ribbon.Converters.NullToVisibility}}" />
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <ContentPresenter
                                        VerticalAlignment="Center"
                                        ContentSource="Content"
                                        TextElement.FontSize="12"
                                        TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path
                                        Width="8"
                                        Height="5"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Data="M0,0 L4,4 L8,0"
                                        Stroke="#6E6E6E"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Popup
                            x:Name="PART_DropDown"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=Bd}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                MinWidth="{Binding ActualWidth, ElementName=Bd}"
                                Margin="6"
                                Padding="3"
                                Background="White"
                                BorderBrush="{StaticResource Namsiz.Ribbon.Brushes.Border}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="12"
                                        Color="Black"
                                        Opacity="0.18"
                                        ShadowDepth="2" />
                                </Border.Effect>
                                <ItemsControl
                                    Focusable="False"
                                    ItemContainerStyle="{StaticResource Namsiz.Ribbon.Styles.MenuButton}"
                                    ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Namsiz.Ribbon.Brushes.ButtonHoverBackground}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Namsiz.Ribbon.Brushes.ButtonHoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Namsiz.Ribbon.Brushes.ButtonPressedBackground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

</ResourceDictionary>
