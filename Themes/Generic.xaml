<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        主题入口（控件默认样式按类型自动查找，应用程序无需显式合并本字典即可使用）。
        字典分工：
          Ribbon.xaml           功能区控件外观（Ribbon / 页签 / 分组 / 下拉按钮 / 命令按钮）
          RibbonItems.xaml      功能区内部的隐式样式（内置 Button / TextBox / Separator），仅由功能区模板合并
          Controls.xaml         通用控件外观：细条滚动条（隐式样式，应用内统一生效）、内容区 Tab 切换按钮
          RibbonWindow.xaml     窗口外观（继承 Namsiz.WPF.Window）、功能栏、内容区、状态栏与忙碌遮罩
          DataGridTabItem.xaml  数据表格 Tab 与数据表格默认样式
          LogTabItem.xaml       日志 Tab 与日志列表默认样式
        消费方若需在应用级覆盖画刷/样式，可在 App.xaml 中合并本字典后再定义同键资源。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Namsiz.WPF.Window.Ribbon;component/Themes/RibbonShared.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Namsiz.WPF.Window.Ribbon;component/Themes/Ribbon.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Namsiz.WPF.Window.Ribbon;component/Themes/Controls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Namsiz.WPF.Window.Ribbon;component/Themes/RibbonWindow.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Namsiz.WPF.Window.Ribbon;component/Themes/DataGridTabItem.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Namsiz.WPF.Window.Ribbon;component/Themes/LogTabItem.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
