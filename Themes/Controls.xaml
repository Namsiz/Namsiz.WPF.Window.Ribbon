<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region 滚动条：细条扁平样式-->
    <!--
        隐式样式（TargetType 无键）：库的主题字典会被自动合并到应用资源，
        因此应用内所有滚动条（DataGrid、日志列表、其它 ScrollViewer）统一生效；
        使用方若想换回系统样式，在 App 资源里定义同类型同键的样式覆盖即可。
    -->
    <Style x:Key="Namsiz.RibbonWindow.Styles.ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="Bd"
                        Background="#B4B4B4"
                        CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#8F8F8F" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#767676" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#E4E4E4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Namsiz.RibbonWindow.Templates.VerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageUpCommand"
                        Focusable="False"
                        Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Margin="2,0" Style="{StaticResource Namsiz.RibbonWindow.Styles.ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageDownCommand"
                        Focusable="False"
                        Opacity="0" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Namsiz.RibbonWindow.Templates.HorizontalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageLeftCommand"
                        Focusable="False"
                        Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Margin="0,2" Style="{StaticResource Namsiz.RibbonWindow.Styles.ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageRightCommand"
                        Focusable="False"
                        Opacity="0" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!--
        细条滚动条：既作为隐式样式（应用内全局生效），也有键名供局部显式套用
        （需要局部显式套用的场景：控件自带模板里的 ScrollViewer，例如 ListBox / DataGrid 内部）。
    -->
    <Style x:Key="Namsiz.RibbonWindow.Styles.SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template" Value="{StaticResource Namsiz.RibbonWindow.Templates.VerticalScrollBar}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template" Value="{StaticResource Namsiz.RibbonWindow.Templates.HorizontalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource Namsiz.RibbonWindow.Styles.SlimScrollBar}" TargetType="ScrollBar" />

    <!--
        最小 ScrollViewer 模板：系统模板会给内部 ScrollBar 指定固定样式（表现 17px 原生条），
        自己给模板后，滚动条才会套用上面的细条样式。
    -->
    <ControlTemplate x:Key="Namsiz.RibbonWindow.Templates.SlimScrollViewer" TargetType="ScrollViewer">
        <Grid Background="{TemplateBinding Background}">
            <ScrollContentPresenter
                x:Name="PART_ScrollContentPresenter"
                Margin="{TemplateBinding Padding}"
                CanContentScroll="{TemplateBinding CanContentScroll}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}" />
            <ScrollBar
                x:Name="PART_VerticalScrollBar"
                HorizontalAlignment="Right"
                Maximum="{TemplateBinding ScrollableHeight}"
                Orientation="Vertical"
                Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                ViewportSize="{TemplateBinding ViewportHeight}"
                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            <ScrollBar
                x:Name="PART_HorizontalScrollBar"
                VerticalAlignment="Bottom"
                Maximum="{TemplateBinding ScrollableWidth}"
                Orientation="Horizontal"
                Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                ViewportSize="{TemplateBinding ViewportWidth}"
                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
        </Grid>
    </ControlTemplate>

    <!--  列表/表格自带模板里的列头：去掉系统那圈 #707070 深边，换成浅灰分隔  -->
    <Style x:Key="Namsiz.RibbonWindow.Styles.DataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="#444444" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border
                            x:Name="Bd"
                            Padding="6,0"
                            Background="#F5F5F5"
                            BorderThickness="0">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
                        </Border>
                        <Thumb
                            x:Name="PART_LeftHeaderGripper"
                            Width="6"
                            HorizontalAlignment="Left"
                            Cursor="SizeWE"
                            Opacity="0">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <Thumb
                            x:Name="PART_RightHeaderGripper"
                            Width="6"
                            HorizontalAlignment="Right"
                            Cursor="SizeWE"
                            Opacity="0">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EDEDED" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Bd" Property="Background" Value="#EAF1FB" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Bd" Property="Background" Value="#EAF1FB" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region 内容区 Tab：扁平化切换按钮（选中项用主色下划线标识）-->
    <Style x:Key="Namsiz.RibbonWindow.Styles.ContentTabItem" TargetType="TabItem">
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border
                        x:Name="Bd"
                        Margin="0,0,2,0"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0,0,0,2"
                        CornerRadius="3,3,0,0">
                        <!--
                            字体强调只作用在标题上：TabItem 上设置 Foreground/FontWeight 会被内容区继承，
                            导致日志、DataGrid 内容变成加粗/变色，这里改为只设置到表头呈现器。
                        -->
                        <ContentPresenter
                            x:Name="Header"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header"
                            TextElement.FontSize="12.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EEF3FA" />
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="#333333" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F8FD" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2F7BF6" />
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="#1F6AEB" />
                            <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="#AAAAAA" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Namsiz.RibbonWindow.Styles.ContentTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Namsiz.RibbonWindow.Styles.ContentTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  内容区（不画边框：上下两条线由背景色自然区分）  -->
                        <Border Grid.Row="0" Background="White">
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                ContentSource="SelectedContent"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>

                        <!--  切换按钮区（底部）：与内容区同底色，不画任何分隔线  -->
                        <Border Grid.Row="1" Background="White">
                            <TabPanel
                                Margin="6,0"
                                IsItemsHost="True"
                                KeyboardNavigation.TabIndex="1" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

</ResourceDictionary>
