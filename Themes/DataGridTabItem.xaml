<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bh="clr-namespace:Namsiz.WPF.Window.Ribbon.Behaviors"
    xmlns:c="clr-namespace:Namsiz.WPF.Window.Ribbon.Controls">

    <ResourceDictionary.MergedDictionaries>
        <!--  用到 Controls.xaml 里的滚动条与列头样式，必须自行合并（同层字典之间不能互相 StaticResource 引用）  -->
        <ResourceDictionary Source="pack://application:,,,/Namsiz.WPF.Window.Ribbon;component/Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--#region 行着色画刷（可按“校验”列着色，键值可在应用资源中覆盖）-->
    <SolidColorBrush x:Key="Namsiz.RibbonWindow.Brushes.ValidationRow.Ok" Color="#E5F5E5" />
    <SolidColorBrush x:Key="Namsiz.RibbonWindow.Brushes.ValidationRow.Warning" Color="#FFF1DC" />
    <SolidColorBrush x:Key="Namsiz.RibbonWindow.Brushes.ValidationRow.Error" Color="#FDE7E7" />
    <!--#endregion-->

    <!--#region 数据表格默认样式：虚拟化 + 行号 + 固定列宽 + Shift+滚轮水平滚动-->
    <!--
        海量数据（十万～百万行）时的性能约定：
        · 行列虚拟化 + 回收模式：只为可视区创建行容器，条目数量不影响滚动开销；
        · 固定行高（RowHeight）+ 固定列宽（AutoWidth=False）：避免逐行/逐列测量内容；
        · 条目滚动（CanContentScroll=True + ScrollUnit=Item）：避免按像素计算百万行的滚动范围；
        · 批量装载请用 DataGridTabItem.BulkLoad，或「后台先建表、再一次性绑定 ItemsSource」；
        · 注意：排序 / 表头筛选是整表运算，百万行上会有秒级耗时（属数据层成本，非界面卡顿）。
    -->
    <Style x:Key="Namsiz.RibbonWindow.Styles.DataGrid" TargetType="DataGrid">
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ColumnHeaderHeight" Value="25" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="RowHeaderWidth" Value="36" />
        <Setter Property="RowHeight" Value="26" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="bh:DataGridAutoColumnBehavior.AutoWidth" Value="False" />
        <Setter Property="bh:DataGridRowNumberBehavior.IsEnabled" Value="True" />
        <Setter Property="bh:DataGridRowNumberBehavior.AutoWidth" Value="True" />
        <Setter Property="bh:ShiftWheelHorizontalScrollBehavior.IsEnabled" Value="True" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style BasedOn="{StaticResource Namsiz.RibbonWindow.Styles.DataGridColumnHeader}" TargetType="DataGridColumnHeader" />
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region 数据表格 Tab（表格由 DataGridTabItem 直接承载，不再需要内容控件模板）-->
    <!--
        DataContext 为所属的 DataGridTabItem：绑定直接指向 Tab 的 ItemsSource / 列定义 / 筛选与校验属性；
        列集变化由 DataGridColumnsBehavior 处理，表头筛选由 DataGridExcelFilterBehavior 安装。
    -->
    <!--
        表格不再由内容控件承载：DataGridTabItem 直接把 DataGrid 作为自身内容，属性用代码同步。
        曾经的"内容控件 + 模板绑定"组合会让海量数据首次布局成倍变慢（5 万行实测 2.2s → 0.1s）。
    -->
    <!--#endregion-->

</ResourceDictionary>
